# Ignore FreeCAD binary files
*.FCStd
*.FCStd1
*.FCBak
*.fctmp

# Ignore FreeCAD app/config files
*.FCMacro

# Keep the launcher script tracked
!launch_freecad.bat

# Ignore large csv result files
results/baking_simulation/*.csv
results/simulation_without_pillars/*.csv
results/simulation_with_pillars/*.csv
results/triangle_simulation/*.csv
results/basket_gmsh_simulation/*.csv

# Override root *.log rule — keep simulation sweep logs
!results/**/*.log