# Ignore FreeCAD binary files
*.FCStd
*.FCStd1
*.FCBak
*.fctmp

# Ignore FreeCAD app/config files
*.FCMacro

# Keep the launcher script tracked
!launch_freecad.bat

# Ignore large result files (regenerated by scripts)
results/**/*.csv
results/**/*.log
results/**/*.docx
results/**/*.txt
# HTML reports are kept in version control
# Raw solver output files
results/**/*.frd
results/**/*.dat
results/**/*.inp
results/**/*.cvg
results/**/*.sta